# Leave both keys empty to use the offline demo engine. CI does that.
# If GROQ_API_KEY is set, the live agent uses Groq llama-3.3-70b-versatile.
# If Groq is missing or fails and GEMINI_API_KEY is set, Gemini 2.5 Flash is next, then Gemini 2.0 Flash.
GROQ_API_KEY=
GEMINI_API_KEY=

# Webhook verify tokens. Defaults to lumen-verify when unset.
WHATSAPP_VERIFY_TOKEN=lumen-verify
MESSENGER_VERIFY_TOKEN=lumen-verify

# Agent desk sign-in. The password is shown in the demo UI on purpose.
AGENT_DESK_PASSWORD=lumen-demo
DESK_SECRET=replace-for-anything-but-the-local-demo
